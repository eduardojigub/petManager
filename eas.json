{
  "cli": {
    "version": ">= 12.5.1",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "preview": {
      "ios": {
        "distribution": "internal",
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "android": {
        "distribution": "internal",
        "buildType": "apk",
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "android": {
        "buildType": "app-bundle",
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      }
    }
  },
  "submit": {
    "internal": {
      "ios": {
        "appleId": "eduardobrunoit@gmail.com",
        "ascAppId": "6737129802",
        "appleTeamId": "BV4VDJR9GL",
        "ascApiKeyPath": "$EXPO_ASC_API_KEY_PATH",
        "ascApiKeyId": "$EXPO_ASC_KEY_ID",
        "ascApiKeyIssuerId": "$EXPO_ASC_ISSUER_ID"
      },
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
